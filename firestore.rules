rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ────────────────────────────────────────────────
    // FUNÇÕES DE SEGURANÇA
    // ────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email == "reskallaarthur@gmail.com";
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ────────────────────────────────────────────────
    // ORDERS (PEDIDOS)
    // ────────────────────────────────────────────────

    match /orders/{orderId} {

      allow read: if isAdmin() ||
        (isAuthenticated() &&
          (resource.data.playerUid == request.auth.uid ||
           resource.data.userId == request.auth.uid)) ||
        (isAuthenticated() &&
          resource.data.assignedTo == request.auth.token.email);

      allow create: if isAuthenticated();

      allow update: if isAdmin() ||
        (isAuthenticated() &&
          (resource.data.playerUid == request.auth.uid ||
           resource.data.userId == request.auth.uid)) ||
        (isAuthenticated() &&
          resource.data.assignedTo == request.auth.token.email);

      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read, write: if isAdmin() ||
          (isAuthenticated() &&
            (get(/databases/$(database)/documents/orders/$(orderId)).data.playerUid == request.auth.uid ||
             get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid)) ||
          (isAuthenticated() &&
            get(/databases/$(database)/documents/orders/$(orderId)).data.assignedTo == request.auth.token.email);
      }

      match /typing/{uid} {
        allow read: if isAuthenticated();
        allow write: if isOwner(uid);
      }
    }

    // ────────────────────────────────────────────────
    // USERS (DADOS PRIVADOS DE PERFIL)
    // ────────────────────────────────────────────────

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ────────────────────────────────────────────────
    // PERFIS (PÚBLICO PARA EVITAR CRASH)
    // ────────────────────────────────────────────────

    match /trainer_profiles/{profileId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers'])
      );
    }

    // ────────────────────────────────────────────────
    // SOCIAL POSTS (CORRIGIDO - SEM DUPLICAÇÃO)
    // ────────────────────────────────────────────────

    match /social_posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.authorUid == request.auth.uid;
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorUid == request.auth.uid);

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // ────────────────────────────────────────────────
    // ADMIN / ESTOQUE
    // ────────────────────────────────────────────────

    match /inventory/{id} { allow read, write: if isAdmin(); }
    match /stock_rooms/{id} { allow read, write: if isAdmin(); }
    match /chest_matches/{id} { allow read, write: if isAdmin(); }
    match /chest_stock/{id} { allow read, write: if isAdmin(); }

    match /breeder_profiles/{email} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.token.email == email);
      allow write: if isAdmin();
    }

    // ────────────────────────────────────────────────
    // DADOS PÚBLICOS (LIBERADOS PRA EVITAR ERRO)
    // ────────────────────────────────────────────────

    match /FAQ/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ClientReviews/{id} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /global_events/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /wishlists/{id} {
      allow read, write: if isAdmin() ||
        (isAuthenticated() &&
          (resource.data.uid == request.auth.uid ||
           request.resource.data.uid == request.auth.uid));
    }

    // ────────────────────────────────────────────────
    // GAMES
    // ────────────────────────────────────────────────

    match /grids/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pokedle/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ────────────────────────────────────────────────
    // SUPORTE
    // ────────────────────────────────────────────────

    match /support_chats/{chatId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);

      match /messages/{msgId} {
        allow read, write: if isAdmin() ||
          (isAuthenticated() &&
            get(/databases/$(database)/documents/support_chats/$(chatId)).data.userId == request.auth.uid);
      }
    }

    // ────────────────────────────────────────────────
    // SAFETY NET
    // ────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
