rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ────────────────────────────────────────────────
    // FUNÇÕES DE SEGURANÇA GLOBAIS
    // ────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email == "reskallaarthur@gmail.com";
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ────────────────────────────────────────────────
    // SISTEMA DE ENCOMENDAS (ORDERS)
    // ────────────────────────────────────────────────

    match /orders/{orderId} {
      // Leitura: admin, dono da encomenda ou responsável atribuído
      allow read: if isAdmin() || 
        (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.playerUid == request.auth.uid)) ||
        (isAuthenticated() && resource.data.assignedTo == request.auth.token.email);

      // Criação: usuário autenticado criando sua própria encomenda com validações básicas
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.totalPrice is number &&
        request.resource.data.totalPrice >= 0;

      // Atualização: admin ou dono (com campos limitados se necessário)
      allow update: if isAdmin() || 
        (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.playerUid == request.auth.uid)) ||
        (isAuthenticated() && resource.data.assignedTo == request.auth.token.email);

      allow delete: if isAdmin();

      // Sub-coleção de mensagens do chat do pedido
      match /messages/{messageId} {
        allow read: if isAdmin() || 
          (isAuthenticated() && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid) ||
          (isAuthenticated() && get(/databases/$(database)/documents/orders/$(orderId)).data.assignedTo == request.auth.token.email);
        
        allow create: if isAuthenticated() &&
          request.resource.data.text is string &&
          request.resource.data.text.size() <= 2000;
          
        allow update, delete: if isAdmin();
      }

      // Sub-coleção de indicadores de digitação
      match /typing/{uid} {
        allow read: if isAuthenticated();
        allow write: if isOwner(uid);
      }
    }

    // ────────────────────────────────────────────────
    // ECOSSISTEMA DE SUPORTE (SUPPORT CHATS)
    // ────────────────────────────────────────────────

    match /support_chats/{chatId} {
      // Leitura: apenas o dono do chat ou o admin
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);

      // Criação: usuário logado, criando chat com seu próprio userId
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // Atualização e deleção: admin ou dono do chat
      allow update: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();

      // Sub-coleção de mensagens do chat de suporte
      match /messages/{messageId} {
        allow read: if isAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/support_chats/$(chatId)).data.userId == request.auth.uid);
        allow create: if isAuthenticated() &&
          request.resource.data.text is string &&
          request.resource.data.text.size() <= 2000;
        allow update, delete: if isAdmin();
      }

      match /typing/{userId} {
        allow read, write: if isOwner(userId);
        allow read: if isAdmin();
      }
    }

    // ────────────────────────────────────────────────
    // PERFIS E DADOS SOCIAIS
    // ────────────────────────────────────────────────

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /trainer_profiles/{profileId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers', 'friends'])
      );

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow delete: if isAdmin() || (isAuthenticated() && (resource.data.authorUid == request.auth.uid || get(/databases/$(database)/documents/trainer_profiles/$(profileId)).data.uid == request.auth.uid));
      }
    }

    match /social_posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.authorUid == request.auth.uid;
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorUid == request.auth.uid);

      // Subcoleções como comentários e curtidas
      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // Sistema de Amizades
    match /friend_requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.fromUid == request.auth.uid || 
        resource.data.toUid == request.auth.uid
      );
      allow create: if isAuthenticated() && 
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if isAuthenticated() && (
        (resource.data.toUid == request.auth.uid && request.resource.data.status == 'accepted') ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.fromUid == request.auth.uid || 
        resource.data.toUid == request.auth.uid
      );
    }

    // ────────────────────────────────────────────────
    // ADMINISTRAÇÃO, ESTOQUE E LOGS
    // ────────────────────────────────────────────────

    match /inventory/{id} { 
      allow read: if isAuthenticated(); // Leitura pública/autenticada para o hub
      allow write: if isAdmin(); 
    }
    match /stock_rooms/{id} { allow read, write: if isAdmin(); }
    match /chest_matches/{id} { allow read, write: if isAdmin(); }
    match /chest_stock/{id} { allow read, write: if isAdmin(); }
    match /admin_dismissed_notifications/{id} { allow read, write: if isAdmin(); }
    
    match /breeder_profiles/{email} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.token.email == email);
      allow write: if isAdmin();
    }

    // ────────────────────────────────────────────────
    // DADOS PÚBLICOS E UTILITÁRIOS
    // ────────────────────────────────────────────────

    match /FAQ/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ClientReviews/{id} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /global_stats/{id} { allow read: if true; allow write: if isAdmin(); }
    match /global_events/{id} { allow read: if true; allow write: if isAdmin(); }
    match /public_stats/{id} { allow read: if true; allow write: if isAdmin(); }

    match /wishlists/{id} {
      allow read, delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow create, update: if isAdmin() || (isAuthenticated() && request.resource.data.uid == request.auth.uid);
    }

    // ────────────────────────────────────────────────
    // MINI-GAMES
    // ────────────────────────────────────────────────

    match /grids/{id} { allow read: if true; allow write: if isAdmin(); }
    match /pokedle/{id} { allow read: if true; allow write: if isAdmin(); }

    // ────────────────────────────────────────────────
    // SAFETY NET (BLOQUEIO GLOBAL)
    // ────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
